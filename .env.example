# =============================================================================
# ForgeMind — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API (apps/api)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# 256-bit AES secret key for encrypting user OAuth credentials (REQUIRED in production)
ENCRYPTION_SECRET=your-32-character-encryption-secret-key

# -----------------------------------------------------------------------------
# Database (Supabase / Prisma)
# -----------------------------------------------------------------------------
# Your Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous public key — safe to use in browser
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — SERVER SIDE ONLY, keep secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Prisma connection string — use the pooler URL from Supabase for serverless
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# For Prisma migrations use the direct connection (non-pooler)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Frontend (apps/web)
# -----------------------------------------------------------------------------
# Next.js public environment variables (exposed to the browser, prefix NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GitHub Webhooks
# -----------------------------------------------------------------------------
# Secret used to verify GitHub webhook delivery signatures (X-Hub-Signature-256).
# Generate with: openssl rand -hex 32
# Set the same value in your GitHub repository webhook settings.
# REQUIRED in production. Leave empty to disable webhook verification (dev only).
GITHUB_WEBHOOK_SECRET=your-randomly-generated-webhook-secret

# -----------------------------------------------------------------------------
# AI / LLM (future sprint)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# -----------------------------------------------------------------------------
# Docker Compose overrides
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=forgemind
