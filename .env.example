# =============================================================================
# ForgeMind — Environment Variables Reference Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Server Configuration (apps/api)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# Comma-separated allowed origins for Express CORS (REQUIRED in production)
# Example: ALLOWED_ORIGINS=https://forgemind.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 256-bit AES secret key for encrypting user OAuth credentials (REQUIRED in production)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=your-32-character-encryption-secret-key

# -----------------------------------------------------------------------------
# Database Configuration (Supabase / PostgreSQL + Prisma)
# -----------------------------------------------------------------------------
# DATABASE_URL: Application runtime query connection string
# Production: Use Supabase Transaction Pooler URL (Port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL: Direct PostgreSQL database connection string (Port 5432)
# Required by Prisma CLI for DDL migrations (prisma migrate deploy)
DIRECT_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Authentication & Identity Service
# -----------------------------------------------------------------------------
# Supabase project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous public API key (safe for browser exposure)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (SERVER-SIDE ONLY, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Web Frontend Configuration (apps/web)
# -----------------------------------------------------------------------------
# Next.js public environment variables (exposed to browser, prefix NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GitHub Integration & Webhook Security
# -----------------------------------------------------------------------------
# Secret used to verify GitHub webhook delivery signatures (X-Hub-Signature-256)
# Generate with: openssl rand -hex 32
# Set the exact same value in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your-randomly-generated-webhook-secret

# -----------------------------------------------------------------------------
# AI / Conversational RAG Engine Configuration
# -----------------------------------------------------------------------------
# Google Gemini API Key for cloud LLM answer synthesis and pgvector embeddings
# When configured, ForgeMind uses Gemini 2.5 Flash for RAG context synthesis.
# If omitted or unconfigured, ForgeMind safely falls back to local deterministic mode.
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key

# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional explicit provider selection ('gemini' | 'openai' | 'local-deterministic')
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Docker Compose overrides
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=forgemind
