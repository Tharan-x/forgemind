{
  "name": "@forgemind/web",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeMind Next.js frontend application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "tsx --env-file=.env.test src/lib/web-client-api.test.ts && tsx --env-file=.env.test src/context/web-context-guards.test.ts && tsx --env-file=.env.test src/app/dashboard/dashboard-pages.test.ts",
    "clean": "rimraf .next dist"
  },
  "dependencies": {
    "@forgemind/shared": "workspace:*",
    "@forgemind/types": "workspace:*",
    "@forgemind/ui": "workspace:*",
    "@supabase/supabase-js": "^2.49.0",
    "@supabase/ssr": "^0.5.2",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@forgemind/eslint-config": "workspace:*",
    "@forgemind/typescript-config": "workspace:*",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
