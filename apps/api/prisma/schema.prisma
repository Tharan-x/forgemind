// =============================================================================
// ForgeMind — Prisma Schema (Sprint 2 Phase 1: Database Foundation)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 1. Users Model ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  repositories      Repository[]
  repositoryMembers RepositoryMember[]
  chatSessions      ChatSession[]
  githubCredential  UserGitHubCredential?
  devices           UserDevice[]

  @@map("users")
}

// ─── 1b. User GitHub Credential Model ───────────────────────────────────────

model UserGitHubCredential {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  encryptedToken  String   @map("encrypted_token")
  githubUsername  String?  @map("github_username")
  githubAvatarUrl String?  @map("github_avatar_url")
  scopes          String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_github_credentials")
}

// ─── 2. Repositories Model ────────────────────────────────────────────────────

model Repository {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  githubId      Int      @unique @map("github_id")
  name          String
  fullName      String   @map("full_name")
  owner         String
  private       Boolean  @default(false)
  defaultBranch String   @default("main") @map("default_branch")
  language      String?
  description   String?
  stars         Int      @default(0)
  forks         Int      @default(0)
  htmlUrl       String   @map("html_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  members      RepositoryMember[]
  analysisJobs AnalysisJob[]
  files        RepositoryFile[]
  symbols      RepositorySymbol[]
  dependencies FileDependency[]
  chunks       CodeChunk[]
  chatSessions ChatSession[]

  @@map("repositories")
}

// ─── 3. Repository Members Model ──────────────────────────────────────────────

model RepositoryMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String   @default("member")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@map("repository_members")
}

// ─── 4. Analysis Jobs Model ───────────────────────────────────────────────────

model AnalysisJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId   String    @map("repository_id") @db.Uuid
  status         String    @default("pending")
  stage          String?   @default("queued")
  stageLabel     String?   @map("stage_label")
  processedCount Int?      @map("processed_count")
  totalCount     Int?      @map("total_count")
  commitHash     String?   @map("commit_hash")
  error          String?
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([repositoryId, status])
  @@map("analysis_jobs")
}

// ─── 5. Chat Sessions Model ───────────────────────────────────────────────────

model ChatSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  title        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([repositoryId, userId])
  @@map("chat_sessions")
}

// ─── 6. Chat Messages Model ───────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  sender    String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ─── 7. Repository Files Model ────────────────────────────────────────────────

model RepositoryFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  path         String
  name         String
  extension    String?
  language     String?
  type         String   @default("file")
  size         Int?
  sha          String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository   Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  symbols      RepositorySymbol[]
  dependencies FileDependency[]
  chunks       CodeChunk[]

  @@unique([repositoryId, path])
  @@map("repository_files")
}

// ─── 8. Repository Symbols Model ──────────────────────────────────────────────

model RepositorySymbol {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  fileId       String   @map("file_id") @db.Uuid
  name         String
  kind         String
  filePath     String   @map("file_path")
  startLine    Int?     @map("start_line")
  endLine      Int?     @map("end_line")
  exported     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([fileId])
  @@map("repository_symbols")
}

// ─── 9. File Dependencies Model ───────────────────────────────────────────────

model FileDependency {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId    String   @map("repository_id") @db.Uuid
  sourceFileId    String   @map("source_file_id") @db.Uuid
  sourcePath      String   @map("source_path")
  targetPath      String   @map("target_path")
  isExternal      Boolean  @default(false) @map("is_external")
  importedSymbols String[] @default([]) @map("imported_symbols")
  createdAt       DateTime @default(now()) @map("created_at")

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceFile RepositoryFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([sourceFileId])
  @@map("file_dependencies")
}

// ─── 10. Code Chunks Model ───────────────────────────────────────────────────

model CodeChunk {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String                       @map("repository_id") @db.Uuid
  fileId       String                       @map("file_id") @db.Uuid
  chunkIndex   Int                          @map("chunk_index")
  content      String                       @db.Text
  filePath     String                       @map("file_path")
  language     String?
  startLine    Int                          @map("start_line")
  endLine      Int                          @map("end_line")
  tokenCount   Int                          @default(0) @map("token_count")
  linesCount   Int                          @default(0) @map("lines_count")
  checksum     String                       @map("checksum")
  metadata     Json?                        @map("metadata")
  embedding    Unsupported("vector(1536)")? @map("embedding")
  createdAt    DateTime                     @default(now()) @map("created_at")

  repository Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepositoryFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([repositoryId])
  @@index([fileId])
  @@index([checksum])
  @@map("code_chunks")
}

// ─── 11. User Devices Model ───────────────────────────────────────────────────

model UserDevice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceId     String    @map("device_id")
  deviceName   String    @map("device_name")
  browser      String?
  os           String?
  isTrusted    Boolean   @default(false) @map("is_trusted")
  trustedUntil DateTime? @map("trusted_until")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

