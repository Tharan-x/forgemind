// =============================================================================
// ForgeMind — Prisma Schema (Sprint 2 Phase 1: Database Foundation)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── 1. Users Model ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  repositories      Repository[]       @relation("RepositoryOwner")
  repositoryMembers RepositoryMember[]
  chatSessions      ChatSession[]

  @@map("users")
}

// ─── 2. Repositories Model ────────────────────────────────────────────────────

model Repository {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  name          String
  fullName      String   @map("full_name")
  githubUrl     String   @map("github_url")
  defaultBranch String   @default("main") @map("default_branch")
  isPrivate     Boolean  @default(false) @map("is_private")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner        User               @relation("RepositoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      RepositoryMember[]
  analysisJobs AnalysisJob[]
  chatSessions ChatSession[]

  @@map("repositories")
}

// ─── 3. Repository Members Model ──────────────────────────────────────────────

model RepositoryMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String   @default("member")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@map("repository_members")
}

// ─── 4. Analysis Jobs Model ───────────────────────────────────────────────────

model AnalysisJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String    @map("repository_id") @db.Uuid
  status       String    @default("pending")
  commitHash   String?   @map("commit_hash")
  error        String?
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("analysis_jobs")
}

// ─── 5. Chat Sessions Model ───────────────────────────────────────────────────

model ChatSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String   @map("repository_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  title        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@map("chat_sessions")
}

// ─── 6. Chat Messages Model ───────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  sender    String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
